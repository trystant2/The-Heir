function resetNameInputMessage(input) {
  input.placeholder = "Introduce your name";
  input.classList.remove("assistant-name-error");
}

  function installNameEntry(assistantWindow, summary) {
    if (summary.querySelector(".assistant-name-entry")) return;

    const nameEntry = document.createElement("div");
    nameEntry.className = "assistant-name-entry";

    const input = document.createElement("input");
    input.className = "assistant-name-input";
    input.type = "text";
    input.placeholder = "Introduce your name";
    input.maxLength = maxNameLength;

    const clearButton = document.createElement("button");
    clearButton.type = "button";
    clearButton.className = "assistant-name-button assistant-name-clear";
    clearButton.textContent = "X";

const randomButton = document.createElement("button");
randomButton.type = "button";
randomButton.className = "assistant-name-button assistant-name-random";
randomButton.setAttribute("aria-label", "Generate random name");
randomButton.textContent = "↻";

    const confirmButton = document.createElement("button");
    confirmButton.type = "button";
    confirmButton.className = "assistant-name-button assistant-name-confirm";
    confirmButton.textContent = "✓";

function submitName() {
  const chosenName = input.value.trim();
  const validation = validateAssistantName(chosenName);

  if (!validation.ok) {
    if (validation.message) {
      showNameInputError(input, validation.message);
    }
    return;
  }

  window.__assistantChosenName = chosenName;
  sessionStorage.setItem("assistantChosenName", chosenName);

  applyAssistantName(summary, chosenName);

  assistantWindow.classList.remove("assistant-locked");
  assistantWindow.classList.add("assistant-name-complete");

  const gameWindow = document.querySelector("#game_window");
  if (gameWindow) gameWindow.classList.remove("assistant-name-pending");

  installAssistantActionButtons(true);
}

clearButton.addEventListener("click", () => {
  input.value = "";
  resetNameInputMessage(input);
  input.focus();
});

randomButton.addEventListener("click", () => {
  input.value = getRandomAssistantName(input.value.trim());
  resetNameInputMessage(input);
  input.dispatchEvent(new Event("input", { bubbles: true }));
  input.focus();
});

    confirmButton.addEventListener("click", submitName);

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        submitName();
      }
    });

input.addEventListener("input", () => {
  if (input.classList.contains("assistant-name-error")) {
    resetNameInputMessage(input);
  }
});

nameEntry.appendChild(input);
nameEntry.appendChild(clearButton);
nameEntry.appendChild(randomButton);
nameEntry.appendChild(confirmButton);

    summary.appendChild(nameEntry);
}

  function installAssistantWindow() {
    ensureMontserrat();

    const assistantWindow = getAssistantWindow();
    const gameWindow = document.querySelector("#game_window");

    if (!assistantWindow) return;

    const select = getAssistantSelect(assistantWindow);
    const summary = assistantWindow.querySelector("#running_mate_summary");
    const description = summary
      ? summary.querySelector('div[style*="overflow-y"], div:not(.assistant-name-entry)')
      : null;

    if (!select || !summary) return;

    assistantWindow.classList.add("assistant-carousel-ready");
    if (gameWindow) gameWindow.classList.add("candidate-carousel-host");

    hideNativeRunningMateSelector(assistantWindow, select);

    if (description) description.classList.add("assistant-redacted-text");

    if (!summary.querySelector(".assistant-redacted-panel")) {
  const redactedPanel = document.createElement("div");
  redactedPanel.className = "assistant-redacted-panel";
  summary.appendChild(redactedPanel);
    }

    const hasName = Boolean(window.__assistantChosenName);

    if (hasName) {
      applyAssistantName(summary, window.__assistantChosenName);
      assistantWindow.classList.remove("assistant-locked");
      assistantWindow.classList.add("assistant-name-complete");
      if (gameWindow) gameWindow.classList.remove("assistant-name-pending");
    } else {
      assistantWindow.classList.add("assistant-locked");
      assistantWindow.classList.remove("assistant-name-complete");
      if (gameWindow) gameWindow.classList.add("assistant-name-pending");
      installNameEntry(assistantWindow, summary);
    }

    installAssistantActionButtons(hasName);
  }

  installAssistantWindow();


              <span id="heir-reading-lock-tip" role="tooltip">
                Win with all the candidates to unlock this section.
              </span>
            `;
          }

          return `<button type="button" id="heir-reading-tab-${key}" role="tab"
            data-reading-tab="${key}" aria-selected="${key === "overview"}"
            aria-controls="heir-reading-panel-${key}">${title}</button>`;
        }).join("")}
      </div>

      <div id="heir-reading-body" tabindex="0">
        ${tabs.filter(([key]) => key !== "lore" || loreUnlocked).map(([key]) => `
          <section id="heir-reading-panel-${key}" role="tabpanel"
            data-reading-panel="${key}" aria-labelledby="heir-reading-tab-${key}"
            ${key === "overview" ? "" : "hidden"}>
            ${pages[key]}

  window.mountHeirFurtherReading = function (assistantName) {
    const root = document.getElementById("heir-further-reading");
    if (!root || root.dataset.mounted === "true") return;
  
const readingScreen = root.closest("#main_content_area_reading") || root.parentElement;
const introText = "Are you interested in exploring the 2024 election further? This page contains some further reading to get you up to speed.";

for (const element of readingScreen.querySelectorAll("p, div, span")) {
  if (element.textContent.replace(/\s+/g, " ").trim() === introText) {

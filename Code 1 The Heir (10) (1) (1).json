function applySafeModeWordRewrites(value) {
    let result = String(value ?? "");

    for (const rule of SAFE_MODE_REWRITE_RULES) {
        result = result.replace(
            rule.pattern,
            (match, ...args) => {
                const replacement =
                    typeof rule.replacement === "function"
                        ? rule.replacement(match, ...args)
                        : rule.replacement;

                return preserveSafeModeCase(
                    match,
                    replacement
                );
            }
        );
    }

    return result;
}

function getSafeModeSentenceParts(value) {
    const text = String(value ?? "");

    if (
        typeof Intl !== "undefined" &&
        typeof Intl.Segmenter === "function"
    ) {
        const segmenter = new Intl.Segmenter(
            "en",
            {granularity: "sentence"}
        );

        return [...segmenter.segment(text)]
            .map(item => item.segment);
    }

    return text.split(/(?<=[.!?])(\s+)/u);
}

function rewriteSafeModeSentence(sentence) {
    if (!/[\p{L}\p{N}]/u.test(sentence)) {
        return sentence;
    }

    const categories =
        getUnsafeSafeModeCategories(sentence);

    const sensitive =
        SAFE_MODE_SENSITIVE_REWRITES.find(rule =>
            categories.includes(rule.category)
        );

    if (!sensitive) {
        return applySafeModeWordRewrites(sentence);
    }

    const whitespace = String(sentence).match(
        /^(\s*)([\s\S]*?)(\s*)$/
    );

    return (
        (whitespace?.[1] || "") +
        sensitive.text +
        (whitespace?.[3] || "")
    );
}

function rewriteSafeModeText(value) {
    return getSafeModeSentenceParts(value)
        .map(rewriteSafeModeSentence)
        .join("");
}

const HEIR_TRANSLATION_PROTECTED_SELECTOR = [
    "script",
    "style",
    "noscript",
    "textarea",
    "select",
    "option",
    "input",
    "button",
    "[role='button']",
    "[role='dialog']",
    "#heir-settings-screen",
    "[data-heir-no-translate]",
    "#the_heir_candidate_vp_carousel",
    "#campaignHqHeirChoiceScreen",
    "#campaignHqPopup",
    "#the_heir_tooltip_popup"
].join(",");

function isHeirTranslationProtected(element) {
    return Boolean(
        element?.closest?.(
            HEIR_TRANSLATION_PROTECTED_SELECTOR
        )
    );
}

function getSafeModeBlock(node) {
    const element = node?.nodeType === Node.ELEMENT_NODE
        ? node
        : node?.parentElement;

    if (!element) return null;

    if (element.closest(
        "#heir-settings-screen,[data-heir-no-translate]," +
        "script,style,noscript,textarea,select,option"
    )) {
        return null;
    }

    const answerLabel = element.closest("#question_form label");

    if (answerLabel) {
        return answerLabel;
    }

    const semanticBlock = element.closest([
        "p",
        "li",
        "blockquote",
        "figcaption",
        ".answer_feedback",
        ".advisor_feedback",
        ".person_summary"
    ].join(","));

    if (semanticBlock) {
        return semanticBlock;
    }

    const gameBlock = element.closest([
        ".inner_window_question",
        "#visit_content",
        "#candidate_description_window",
        "#running_mate_description_window",
        "#election_description_window",
        "#opponent_selection_description_window",
        "#overall_result",
        "#state_result"
    ].join(","));

    if (gameBlock) {
        return gameBlock;
    }

    if (!element.closest(
        "button,input,textarea,select,option"
    )) {
        return element;
    }

    return null;
}

function getSafeModeTextNodes(block) {
    if (!block) return [];

    const nodes = [];

    const walker = document.createTreeWalker(
        block,
        NodeFilter.SHOW_TEXT,
        {
            acceptNode(textNode) {
                const parent = textNode.parentElement;

                if (!parent) {
                    return NodeFilter.FILTER_REJECT;
                }

                if (parent.closest(
                    "script,style,noscript,textarea,select,option,button," +
                    "#heir-settings-screen,[data-heir-no-translate]"
                )) {
                    return NodeFilter.FILTER_REJECT;
                }

                if (getSafeModeBlock(textNode) !== block) {
                    return NodeFilter.FILTER_REJECT;
                }

                const original =
                    originalText.get(textNode) ??
                    textNode.nodeValue ??
                    "";

                return /[\p{L}\p{N}]/u.test(original)
                    ? NodeFilter.FILTER_ACCEPT
                    : NodeFilter.FILTER_REJECT;
            }
        }
    );

    while (walker.nextNode()) {
        nodes.push(walker.currentNode);
    }

    return nodes;
}

function getSafeModeReplacement() {
    /*
     * Safe Mode ya no elimina bloques.
     * La reescritura se realiza después, texto por texto.
     */
    return null;
}


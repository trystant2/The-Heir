    root.querySelector("[data-heir-reading-assistant]").textContent = assistantName || "You";

    const tabList = root.querySelector("#heir-reading-tabs");
    const scrollBody = root.querySelector("#heir-reading-body");
    const buttons = [...tabList.querySelectorAll("[data-reading-tab]")];
    const panels = [...scrollBody.querySelectorAll("[data-reading-panel]")];

    function selectTab(button) {
      const key = button.dataset.readingTab;

      for (const tab of buttons) {

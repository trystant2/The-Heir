function replaceAssistantNameToken(node, name) {
  const token = "#AÑADIR NOMBRE AQUÍ#";
  const parts = node.nodeValue.split(token);

  if (parts.length === 1 || !node.parentNode) return false;

  const fragment = document.createDocumentFragment();

  parts.forEach((part, index) => {
    if (part) fragment.appendChild(document.createTextNode(part));

    if (index < parts.length - 1) {
      fragment.appendChild(createAssistantNameSpan(name));
    }
  });

  node.parentNode.replaceChild(fragment, node);
  return true;
}

function updateAssistantSummaryName(summary, name) {
  const walker = document.createTreeWalker(summary, NodeFilter.SHOW_TEXT);
  const ignoredSelector =
    ".assistant-name-entry, .assistant-redacted-panel, .assistant-inserted-name";

  while (walker.nextNode()) {
    const node = walker.currentNode;
    const parent = node.parentElement;

    if (parent && parent.closest(ignoredSelector)) continue;
    if (!/Name:\s*/i.test(node.nodeValue)) continue;

    const text = node.nodeValue;
    const match = text.match(/Name:\s*/i);
    const nameStart = match.index + match[0].length;
    const afterName = text.slice(nameStart);
    const lineBreakIndex = afterName.search(/[\r\n]/);
    const nameEnd =
      lineBreakIndex === -1 ? text.length : nameStart + lineBreakIndex;

    const currentName = text.slice(nameStart, nameEnd).trim();
    if (currentName === name) return false;

    node.nodeValue = text.slice(0, nameStart) + name + text.slice(nameEnd);
    return true;
  }

  return false;
}

function applyAssistantName(summary, name) {
  const chosenName = (name || "").trim();
  if (!chosenName) return;

  updateAssistantSummaryName(summary, chosenName);

  if (summary.dataset.assistantAppliedName === chosenName) return;

  const existingNames = summary.querySelectorAll(".assistant-inserted-name strong");

  if (existingNames.length) {
    existingNames.forEach((strong) => {
      if (strong.textContent !== chosenName) {
        strong.textContent = chosenName;
      }
    });

    summary.dataset.assistantAppliedName = chosenName;
    return;
  }

  const description = summary.querySelector(".assistant-redacted-text") || summary;
  const walker = document.createTreeWalker(description, NodeFilter.SHOW_TEXT);
  const nodes = [];

  while (walker.nextNode()) {
    nodes.push(walker.currentNode);
  }

  let changed = false;

  nodes.forEach((node) => {
    if (node.nodeValue.includes("#AÑADIR NOMBRE AQUÍ#")) {
      changed = replaceAssistantNameToken(node, chosenName) || changed;
    }
  });

  if (changed) {
    summary.dataset.assistantAppliedName = chosenName;
  }
}


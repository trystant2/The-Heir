function isProcessableText(node) {
    if (
        !node ||
        node.nodeType !== Node.TEXT_NODE ||
        !node.parentElement
    ) {
        return false;
    }

    if (
        isHeirTranslationProtected(
            node.parentElement
        )
    ) {
        return false;
    }

    return /\p{L}/u.test(
        originalText.get(node) ??
        node.nodeValue ??
        ""
    );
}

function writeNode(node,text) {
if (!node.isConnected || node.nodeValue === text) return;

internalWrites.add(node);
node.nodeValue = text;

setTimeout(() => internalWrites.delete(node),0);
}

function splitText(text,maxLength = 800) {
const result = [];
let remaining = text;

while (remaining.length > maxLength) {
let position = remaining.lastIndexOf(" ",maxLength);
if (position < maxLength * 0.5) position = maxLength;

result.push(remaining.slice(0,position));
remaining = remaining.slice(position);
}

if (remaining) result.push(remaining);
return result;
}

function separateWhitespace(text) {
const match = String(text).match(/^(\s*)([\s\S]*?)(\s*)$/);

return {
prefix: match?.[1] || "",
core: match?.[2] || "",
suffix: match?.[3] || ""
};
}

function escapeTranslationRegex(value) {
    return String(value).replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&"
    );
}

function getProtectedTranslationRegex() {
    /*
     * También recoge automáticamente los términos que
     * actualmente aparecen convertidos en tooltips.
     */
    const tooltipTerms = [
        ...document.querySelectorAll(
            ".heir-tooltip-term"
        )
    ]
        .map(element =>
            String(element.textContent || "").trim()
        )
        .filter(Boolean);

    const terms = [
        ...new Set([
            ...PROTECTED_TRANSLATION_TERMS,
            ...tooltipTerms
        ])
    ]
        .sort((first, second) =>
            second.length - first.length
        )
        .map(escapeTranslationRegex);

    if (!terms.length) return null;

    return new RegExp(
        `(^|[^\\p{L}\\p{N}_])(${terms.join("|")})(?=$|[^\\p{L}\\p{N}_])`,
        "giu"
    );
}

function protectTranslationTerms(value) {
    const protectedValues = [];

    function preserve(match) {
        const index =
            protectedValues.push(match) - 1;

        /*
         * Secuencia deliberadamente extraña para que el
         * servicio de traducción no intente traducirla.
         */
        return `ZXQHEIRKEEP${index}QXZ`;
    }

    let protectedText = String(value ?? "");

    /*
     * Protege los marcadores utilizados para integrar los
     * tooltips dentro de la frase.
     */
    protectedText = protectedText.replace(
        /__HEIR_TOOLTIP_\d+__/g,
        match => preserve(match)
    );

    const properNameRegex =
        getProtectedTranslationRegex();

    if (properNameRegex) {
        protectedText = protectedText.replace(
            properNameRegex,
            (completeMatch, prefix, properName) =>
                prefix + preserve(properName)
        );
    }

    return {
        text: protectedText,
        values: protectedValues
    };
}

function restoreTranslationTerms(
    translatedText,
    protectedValues
) {
    return String(translatedText ?? "").replace(
        /ZXQHEIRKEEP(\d+)QXZ/gi,
        (placeholder, rawIndex) => {
            const index = Number(rawIndex);

            return protectedValues[index] ??
                placeholder;
        }
    );
}

async function requestTranslation(
    text,
    languageCode
) {
    const protectedInput =
        protectTranslationTerms(text);

    const url =
        "https://translate.googleapis.com/translate_a/single" +
        `?client=gtx&sl=en&tl=${encodeURIComponent(languageCode)}` +
        `&dt=t&q=${encodeURIComponent(protectedInput.text)}`;

    const response = await fetch(url);

    if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
    }

    const result = await response.json();

    const translated = Array.isArray(result?.[0])
        ? result[0]
            .map(part => part?.[0] || "")
            .join("")
        : protectedInput.text;

    return restoreTranslationTerms(
        translated,
        protectedInput.values
    );
}

function createBatchHtml(segments) {
const token =
`heir_tx_${Date.now()}_${Math.random().toString(36).slice(2)}`;

const holder = document.createElement("div");

segments.forEach((segment,index) => {
const span = document.createElement("span");
span.id = `${token}_${index}`;
span.textContent = segment;
holder.appendChild(span);
});

return {token,html:holder.innerHTML};
}

async function translateBatch(segments,languageCode) {
if (!segments.length) return [];

const batch = createBatchHtml(segments);

try {
const translatedHtml = await requestTranslation(batch.html,languageCode);
const template = document.createElement("template");
template.innerHTML = translatedHtml;

const translated = segments.map((segment,index) => {
return template.content.querySelector(
`#${batch.token}_${index}`
)?.textContent ?? null;
});

if (translated.every(value => value !== null)) return translated;
} catch {}

return Promise.all(
segments.map(segment => requestTranslation(segment,languageCode))
);
}

function createBatches(segments,maxCharacters = 1800) {
const batches = [];
let current = [];
let length = 0;

segments.forEach(segment => {
if (current.length && length + segment.length > maxCharacters) {
batches.push(current);
current = [];
length = 0;
}

current.push(segment);
length += segment.length;
});

if (current.length) batches.push(current);
return batches;
}

async function runBatches(batches,languageCode,limit = 4) {
const results = new Array(batches.length);
let next = 0;

async function worker() {
while (next < batches.length) {
const index = next++;
results[index] = await translateBatch(batches[index],languageCode);
}
}

await Promise.all(
Array.from(
{length:Math.min(limit,Math.max(1,batches.length))},
worker
)
);

return results.flat();
}

async function translateMissing(segments,languageCode) {
const unique = [...new Set(segments)].filter(segment => {
return !translationCache.has(`${languageCode}\u0000${segment}`);
});

if (!unique.length) return;

try {
const translated = await runBatches(
createBatches(unique),
languageCode
);

unique.forEach((segment,index) => {
translationCache.set(
`${languageCode}\u0000${segment}`,
translated[index] ?? segment
);
});
} catch (error) {
unique.forEach(segment => {
translationCache.set(`${languageCode}\u0000${segment}`,segment);
});

if (!translationWarningShown) {
translationWarningShown = true;
console.warn(
"The Heir: no se ha podido completar la traducción.",
error
);
}
}
}

function translatedSegment(segment,languageCode) {
return translationCache.get(
`${languageCode}\u0000${segment}`
) ?? segment;
}

function getTooltipTranslationParent(node) {
    if (
        !node ||
        node.nodeType !== Node.TEXT_NODE ||
        !node.parentElement
    ) {
        return null;
    }

    const containingTooltip =
        node.parentElement.closest(
            ".heir-tooltip-term"
        );

    if (containingTooltip) {
        return containingTooltip.parentElement;
    }

    /*
     * Busca un padre en el que el texto y el tooltip sean
     * hermanos. Esto permite traducirlos como una frase.
     */
    let current = node.parentElement;

    while (
        current &&
        current !== document.body
    ) {
        const hasDirectTooltip = [
            ...current.children
        ].some(element =>
            element.classList?.contains(
                "heir-tooltip-term"
            )
        );

        if (hasDirectTooltip) {
            return current;
        }

        current = current.parentElement;
    }

    return null;
}

function buildTooltipTranslationGroups(parent) {
    const groups = [];
    let currentNodes = [];

    function finishCurrentGroup() {
        if (!currentNodes.length) return;

        const containsTooltip =
            currentNodes.some(node =>
                node.nodeType === Node.ELEMENT_NODE &&
                node.classList.contains(
                    "heir-tooltip-term"
                )
            );

        const containsText =
            currentNodes.some(node =>
                node.nodeType === Node.TEXT_NODE
            );

        if (containsTooltip && containsText) {
            groups.push(
                createTooltipTranslationGroup(
                    parent,
                    currentNodes
                )
            );
        }

        currentNodes = [];
    }

    [...parent.childNodes].forEach(node => {
        const isText =
            node.nodeType === Node.TEXT_NODE;

        const isTooltip =
            node.nodeType === Node.ELEMENT_NODE &&
            node.classList.contains(
                "heir-tooltip-term"
            );

        if (isText || isTooltip) {
            currentNodes.push(node);
        } else {
            finishCurrentGroup();
        }
    });

    finishCurrentGroup();

    return groups.filter(Boolean);
}

function createTooltipTranslationGroup(
    parent,
    nodes
) {
    const markers = [];
    const tooltipElements = [];
    const slots = [[]];

    let slotIndex = 0;
    let source = "";

    nodes.forEach(node => {
        if (node.nodeType === Node.TEXT_NODE) {
            if (!originalText.has(node)) {
                originalText.set(
                    node,
                    node.nodeValue
                );
            }

            const original =
                originalText.get(node) ??
                node.nodeValue ??
                "";

            const processed =
                activeSettings.safeMode === "Yes"
                    ? rewriteSafeModeText(original)
                    : original;

            slots[slotIndex].push({
                node,
                original
            });

            source += processed;
            return;
        }

        const marker =
            `__HEIR_TOOLTIP_${markers.length}__`;

        markers.push(marker);
        tooltipElements.push(node);
        source += marker;

        slotIndex++;
        slots[slotIndex] = [];
    });

    return {
        parent,
        source,
        markers,
        tooltipElements,
        slots
    };
}

function splitTooltipTranslation(
    translated,
    markers
) {
    const parts = [];
    let remaining = String(translated ?? "");

    for (const marker of markers) {
        const position =
            remaining.indexOf(marker);

        if (position === -1) {
            return null;
        }

        parts.push(
            remaining.slice(0, position)
        );

        remaining = remaining.slice(
            position + marker.length
        );
    }

    parts.push(remaining);

    return parts;
}

function applyTooltipTranslation(
    group,
    translated
) {
    const parts = splitTooltipTranslation(
        translated,
        group.markers
    );

    if (
        !parts ||
        parts.length !== group.slots.length
    ) {
        console.warn(
            "The Heir: no se pudieron restaurar los marcadores del tooltip.",
            translated
        );

        return;
    }

    group.slots.forEach((slot, index) => {
        if (!slot.length) return;

        /*
         * Mantiene todos los elementos HTML originales.
         * Únicamente cambia sus nodos de texto.
         */
        slot.forEach((entry, nodeIndex) => {
            if (
                !entry.node.isConnected ||
                originalText.get(entry.node) !==
                    entry.original
            ) {
                return;
            }

            writeNode(
                entry.node,
                nodeIndex === 0
                    ? parts[index]
                    : ""
            );
        });
    });
}

function queueTooltipParent(parent) {
    if (
        !parent ||
        !parent.isConnected
    ) {
        return;
    }

    pendingTooltipParents.add(parent);

    if (tooltipTranslationTimer !== null) {
        return;
    }

    tooltipTranslationTimer =
        window.setTimeout(() => {
            tooltipTranslationTimer = null;
            void flushTooltipParents();
        }, 16);
}

async function flushTooltipParents() {
    const generation = translationGeneration;

    const parents = [
        ...pendingTooltipParents
    ];

    pendingTooltipParents.clear();

    const groups = parents
        .filter(parent => parent.isConnected)
        .flatMap(buildTooltipTranslationGroups);

    if (!groups.length) return;

    const language =
        LANGUAGES.find(item =>
            item.name === activeSettings.language
        ) || LANGUAGES[0];

    if (language.code !== "en") {
        await translateMissing(
            groups.map(group => group.source),
            language.code
        );
    }

    if (
        generation !== translationGeneration
    ) {
        return;
    }

    groups.forEach(group => {
        const translated =
            language.code === "en"
                ? group.source
                : translatedSegment(
                    group.source,
                    language.code
                );

        applyTooltipTranslation(
            group,
            translated
        );
    });
}

function queueTextNode(node) {
    if (internalWrites.has(node)) return;

    /*
     * Si forma parte de una frase con tooltip, traduce toda
     * la secuencia conjuntamente.
     */
    const tooltipParent =
        getTooltipTranslationParent(node);

    if (tooltipParent) {
        queueTooltipParent(tooltipParent);
        return;
    }

    if (!isProcessableText(node)) return;

    if (!originalText.has(node)) {
        originalText.set(node, node.nodeValue);
    }

    const original =
        originalText.get(node) ??
        node.nodeValue;

    /*
     * Safe Mode se ejecuta antes que la traducción.
     */
    if (activeSettings.safeMode === "Yes") {
        const safeModeReplacement =
            getSafeModeReplacement(node);

        if (safeModeReplacement) {
            writeNode(
                node,
                safeModeReplacement.text
            );

            pendingNodes.delete(node);
            return;
        }
    }

const source = activeSettings.safeMode === "Yes"
    ? rewriteSafeModeText(original)
    : original;

    const language =
        LANGUAGES.find(item =>
            item.name === activeSettings.language
        ) || LANGUAGES[0];

    if (language.code === "en") {
        writeNode(node, source);
        pendingNodes.delete(node);
        return;
    }

    const whitespace =
        separateWhitespace(source);

    const segments =
        splitText(whitespace.core);

    const translationIsCached =
        segments.every(segment =>
            translationCache.has(
                `${language.code}\u0000${segment}`
            )
        );

    if (translationIsCached) {
        const translated = segments
            .map(segment =>
                translatedSegment(
                    segment,
                    language.code
                )
            )
            .join("");

        writeNode(
            node,
            whitespace.prefix +
            translated +
            whitespace.suffix
        );

        pendingNodes.delete(node);
        return;
    }

    pendingNodes.add(node);

    if (translationTimer !== null) return;

    translationTimer = setTimeout(() => {
        translationTimer = null;
        void flushTextNodes();
    }, 16);
}

async function flushTextNodes() {
    const generation = translationGeneration;
    const nodes = [...pendingNodes];

    pendingNodes.clear();

    if (!nodes.length) return;

    const language =
        LANGUAGES.find(item =>
            item.name === activeSettings.language
        ) || LANGUAGES[0];

    const normalNodes = [];

    /*
     * Vuelve a comprobar los bloques antes de enviarlos al traductor.
     * Es necesario si Campaign HQ ha recreado el contenido mientras
     * los textos estaban en la cola.
     */
    nodes.forEach(node => {
        if (
            !node.isConnected ||
            !isProcessableText(node)
        ) {
            return;
        }

        if (!originalText.has(node)) {
            originalText.set(
                node,
                node.nodeValue
            );
        }

        if (activeSettings.safeMode === "Yes") {
            const safeModeReplacement =
                getSafeModeReplacement(node);

            if (safeModeReplacement) {
                writeNode(
                    node,
                    safeModeReplacement.text
                );

                return;
            }
        }

        normalNodes.push(node);
    });

    const entries = normalNodes.map(node => {
        const original =
            originalText.get(node) ??
            node.nodeValue;

const source = activeSettings.safeMode === "Yes"
    ? rewriteSafeModeText(original)
    : original;

        const whitespace =
            separateWhitespace(source);

        const segments =
            splitText(whitespace.core);

        return {
            node,
            original,
            source,
            whitespace,
            segments
        };
    });

    if (!entries.length) return;

    if (language.code === "en") {
        entries.forEach(entry =>
            writeNode(
                entry.node,
                entry.source
            )
        );

        return;
    }

    await translateMissing(
        entries.flatMap(entry =>
            entry.segments
        ),
        language.code
    );

    if (
        generation !== translationGeneration
    ) {
        return;
    }

    entries.forEach(entry => {
        if (
            !entry.node.isConnected ||
            originalText.get(entry.node) !==
                entry.original
        ) {
            return;
        }

        const translated = entry.segments
            .map(segment =>
                translatedSegment(
                    segment,
                    language.code
                )
            )
            .join("");

        writeNode(
            entry.node,
            entry.whitespace.prefix +
            translated +
            entry.whitespace.suffix
        );
    });
}

function processTree(root) {
if (!root) return;

if (root.nodeType === Node.TEXT_NODE) {
queueTextNode(root);
return;
}

if (
    root.nodeType !== Node.ELEMENT_NODE &&
    root !== document.body
) {
    return;
}

if (
    root !== document.body &&
    isHeirTranslationProtected(root)
) {
    return;
}

const walker = document.createTreeWalker(
root,
NodeFilter.SHOW_TEXT
);

while (walker.nextNode()) {
queueTextNode(walker.currentNode);
}
}

function refreshText() {
    translationGeneration++;

    processTree(document.body);

    if (translationTimer !== null) {
        clearTimeout(translationTimer);
        translationTimer = null;
    }

    if (tooltipTranslationTimer !== null) {
        clearTimeout(tooltipTranslationTimer);
        tooltipTranslationTimer = null;
    }

    void Promise.all([
        flushTextNodes(),
        flushTooltipParents()
    ]);
}

const textObserver = new MutationObserver(mutations => {
mutations.forEach(mutation => {
if (mutation.type === "characterData") {
const node = mutation.target;

if (internalWrites.has(node)) return;

originalText.set(node,node.nodeValue);
queueTextNode(node);
return;
}

mutation.addedNodes.forEach(processTree);
});
});

function applyRuntimeSettings(settings) {
activeSettings = sanitizeSettings(settings);

window.theHeirSettings = {...activeSettings};
window.theHeirLanguage = activeSettings.language;
window.safeMode = activeSettings.safeMode === "Yes";
window.slide = activeSettings.slide;

refreshText();
}

applyRuntimeSettings(activeSettings);

textObserver.observe(document.body,{
childList:true,
characterData:true,
subtree:true
});


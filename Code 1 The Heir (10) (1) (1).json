grid.append(row.label,row.carousel);
});

const footer = document.createElement("div");
footer.className = "heir-settings-footer";

const reset = document.createElement("button");
reset.type = "button";
reset.className = "heir-settings-reset";
reset.textContent = "Back to original settings";

reset.addEventListener("click",() => {
resetSettings(nativeDifficulty,nativeGameType,state);
});

const actions = document.createElement("div");
actions.className = "heir-settings-actions";

const back = document.createElement("button");
back.type = "button";
back.textContent = "Back";

back.addEventListener("click",() => {
draftSettings = {...activeSettings};
nativeBack.click();
});

const continueButton = document.createElement("button");
continueButton.type = "button";
continueButton.textContent = "Continue";

continueButton.addEventListener("click",() => {
commitSettings(nativeDifficulty,nativeGameType);
nativeContinue.click();
});

actions.append(back,continueButton);
footer.append(reset,actions);
screen.append(title,grid,footer);

gameWindow.appendChild(screen);
gameWindow.classList.add("heir-settings-host");

renderAll(state);
}

const screenObserver = new MutationObserver(installSettingsScreen);

screenObserver.observe(document.body,{
childList:true,
subtree:true
});

window.__theHeirSettingsScreenInstalled = true;
installSettingsScreen();
})();


  });

function getRandomAssistantName(currentName) {
  const availableNames = randomAssistantNames.filter((name) => {
    return name !== currentName;
  });
  const names = availableNames.length ? availableNames : randomAssistantNames;

  return names[Math.floor(Math.random() * names.length)] || "";
